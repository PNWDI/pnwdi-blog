---
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About Us"
	description="Two tech enthusiasts sharing their experiences in the world of software development and technology."
	pubDate={new Date('April 08 2024')}
	heroImage="/pnwdi.png"
>
	<p>
		<div style={`display: grid; grid-template-columns: repeat(2, 1fr); gap: 6rem;`}>
			<div>
				<img src="/josh.jpg" alt="Josh Rogers" class="author-image" />
				Global experience across multiple industries allows Josh to showcase how you can scale and diversify your business offerings.<br>
				<b>
					Josh Rogers<br>
					Chief Executive Officer
				</b>
			</div>
			<div>
				<img src="/rob.jpg" alt="Robert Hull" class="author-image" />
				Specializing in all consumer technology and wireless standards, Rob brings decades of hardware and networking experience to your business.<br>
				<b>
					Robert Hull<br>
					Chief Technology Officer
				</b>
			</div>
		</div>
	</p>
</Layout>
